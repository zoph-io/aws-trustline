# Copy to samconfig.toml and edit. `sam deploy` will read these defaults so
# you can re-deploy without retyping parameters every time.
version = 0.1

[default.global.parameters]
stack_name = "aws-trustline"

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "aws-trustline"
region = "eu-west-1"
parameter_overrides = [
  "Scope=auto",
  "Regions=all",
  "ScheduleExpression=cron(0 6 * * ? *)",
  "ScheduleTimezone=UTC",
  "AlertEmail=",
  "LambdaMemoryMB=512",
  "LambdaTimeoutSeconds=600",
  "LogRetentionDays=30",
  "ReportRetentionDays=365",
]
