# Trusted Accounts Configuration
# Copy to trusted_accounts.yaml (gitignored). Member accounts cannot call
# organizations:ListAccounts — without this file, org siblings show as unknown.

# Each entry is a named group of 12-digit account IDs.

- name: "My Company Production"
  description: "Production AWS accounts"
  accounts:
    - "123456789012"
    - "234567890123"

- name: "My Company Development"
  description: "Development and testing AWS accounts"
  accounts:
    - "345678901234"
    - "456789012345"

- name: "Subsidiary Company"
  description: "Our subsidiary organization AWS accounts"
  accounts:
    - "567890123456"
